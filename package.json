{
  "name": "la-sirena",
  "version": "1.0.0",
  "description": "A full-length audio-reactive procedural music film for song.mod",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "node scripts/verify.mjs",
    "verify:score": "node scripts/native-plan.mjs --source-only --output artifacts/qa/score-check.jsonl",
    "verify:render-state": "node scripts/check-render-state.mjs",
    "profile:render": "node scripts/profile-render.mjs",
    "audio:prepare": "python3 scripts/prepare-audio.py",
    "render": "node scripts/render-film.mjs",
    "render:native": "node scripts/render-native.mjs",
    "render:full": "node scripts/render-native.mjs --full",
    "render:4k": "node scripts/render-native.mjs --full --width 3840 --height 2160 --fps 60 --codec libsvtav1 --preset 6 --crf 18 --threads 4 --pause-ms 50 --output artifacts/la-sirena-4k60-svt-av1.mp4",
    "check": "npm run verify:score && npm run verify:render-state"
  },
  "type": "module",
  "devDependencies": {
    "playwright": "^1.63.0",
    "vite": "^8.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
